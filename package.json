{
	"name": "flashcards-md",
	"version": "1.0.0",
	"description": "Obsidian plugin: study flashcards written in fenced code blocks.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"banner": "node docs/banner/render.mjs"
	},
	"keywords": [
		"obsidian",
		"flashcards"
	],
	"license": "GPL-3.0-only",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"playwright": "^1.64.1",
		"tslib": "^2.6.0",
		"typescript": "^5.4.0"
	}
}
